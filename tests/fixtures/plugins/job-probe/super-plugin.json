{
  "manifestVersion": 1,
  "id": "com.super.job-probe",
  "version": "1.0.0",
  "name": "Job Probe",
  "description": "Fixed test plugin that registers a tick job handler and enqueues once on activate.",
  "author": "Super",
  "license": "MIT",
  "engines": {
    "super": ">=0.1.0 <1.0.0",
    "pluginApi": 1
  },
  "runtime": {
    "mode": "restricted",
    "entry": "entry/main.js"
  },
  "permissions": [
    "library.read",
    "job.manage",
    "storage.read",
    "storage.write"
  ],
  "contributes": {
    "commands": [
      {
        "id": "start",
        "title": "Start probe"
      }
    ],
    "menus": {},
    "views": [],
    "settings": [],
    "hooks": [],
    "jobs": [
      {
        "id": "tick",
        "title": "Tick probe",
        "recovery": "idempotent"
      }
    ],
    "providers": []
  }
}
